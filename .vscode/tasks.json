{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build C with OpenMP",
      "type": "shell",
      "command": "gcc",
      "args": [
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}",
        "-Wall",
        "-Wextra",
        "-g",
        "-fopenmp"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}