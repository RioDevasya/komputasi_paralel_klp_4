{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Test",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-fopenmp",
                "-g",
                "-Wall",
                "-Wextra",
                "${workspaceFolder}/test_sorting.c",
                "-o",
                "${workspaceFolder}/test_sorting",
                "${workspaceFolder}/utilitas.c",
                "-I${workspaceFolder}/include"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build Parallel: OpenMP",
            "type": "shell",
            "command": "mpicc",
            "args": [
                "-fopenmp",
                "-g",
                "-Wall",
                "-Wextra",
                "${workspaceFolder}/main_parallel.c",
                "-o",
                "${workspaceFolder}/main_parallel",
                "${workspaceFolder}/utilitas.c",
                "-I${workspaceFolder}/include"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build Distributed: OpenMPI",
            "type": "shell",
            "command": "mpicc",
            "args": [
                "-fopenmp",
                "-g",
                "-Wall",
                "-Wextra",
                "${workspaceFolder}/main_distributed.c",
                "-o",
                "${workspaceFolder}/main_distributed",
                "${workspaceFolder}/utilitas.c",
                "-I${workspaceFolder}/include"
            ],
            "group": {
                
                "kind": "build",
                "isDefault": true
            },
        },
        {
            "label": "Build Distributed + Parallel: OpenMP + OpenMPI",
            "type": "shell",
            "command": "mpicc",
            "args": [
                "-fopenmp",
                "-g",
                "-Wall",
                "-Wextra",
                "${workspaceFolder}/distributed_and_parallel.c",
                "-o",
                "${workspaceFolder}/distributed_and_parallel",
                "${workspaceFolder}/distributed.c",
                "${workspaceFolder}/utilitas.c",
                "-I${workspaceFolder}/include"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
        },
        {
            "label": "Build All: OpenMP, OpenMPI",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build Test",
                "Build Parallel: OpenMP",
                "Build Distributed: OpenMPI",
                "Build Distributed + Parallel: OpenMP + OpenMPI"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}